// ----------------------------------------------------------------------------
// Payment evidence and exceptions (specs/commerce/25 slice S1, 2026-10-31)
// ----------------------------------------------------------------------------

// What a signed provider callback was, decided from SIGNED fields only
// (PAYMOB_HMAC_KEYS). Only PAYMENT is ever applied to an order group.
enum PaymentProviderEventKind {
  PAYMENT // success, not pending, no error, not a refund/void/child transaction
  DECLINED // signed, final, not successful
  PENDING
  REFUND // is_refunded, or a child transaction that is not a void
  VOID // is_voided, or a void child transaction
  OTHER // e.g. an authorization-only transaction
}

enum PaymentExceptionType {
  DOUBLE_PAYMENT // a second, different successful charge on a group that already recorded one
  LATE_PAYMENT // charge arrived after the group was cancelled or expired (BD-17: refund or manual)
  AMOUNT_MISMATCH // charged amount differs from the group's expected total
  CURRENCY_MISMATCH // charged currency is not EGP (or missing)
  UNMATCHED_PAYMENT // a signed, successful charge that matches no order group at all
}

enum PaymentExceptionStatus {
  OPEN
  RESOLVED
}

// Every signed provider callback, stored before anything is applied: the
// evidence trail, and the database-level idempotency of webhook processing.
// Append-only except outcome / handler / processedAt (trigger in the migration).
model PaymentProviderEvent {
  id                    String                   @id @default(uuid())
  provider              String                   @db.VarChar(32)
  providerTransactionId String                   @db.VarChar(64)
  kind                  PaymentProviderEventKind
  signedOrderId         String?                  @db.VarChar(64)
  amountCents           Int?
  currency              String?                  @db.VarChar(8)
  payload               Json
  // null until processed; a callback received but not processed (crash) is
  // re-processed when the provider retries it.
  outcome               String?                  @db.VarChar(32)
  handler               String?                  @db.VarChar(64)
  receivedAt            DateTime                 @default(now())
  processedAt           DateTime?

  @@unique([provider, providerTransactionId, kind])
  @@index([receivedAt])
  @@map("payment_provider_events")
}

// A payment that was charged but must not (or cannot) be applied normally.
// Written in the same transaction as the decision, so it exists exactly when
// the outcome was committed. Never deleted; only status / resolution change.
model PaymentException {
  id                    String                 @id @default(uuid())
  type                  PaymentExceptionType
  status                PaymentExceptionStatus @default(OPEN)
  // null only for UNMATCHED_PAYMENT (CHECK in the migration)
  orderGroupId          String?
  orderGroup            OrderGroup?            @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  provider              String                 @db.VarChar(32)
  providerTransactionId String                 @db.VarChar(64)
  amountCents           Int
  currency              String?                @db.VarChar(8)
  expectedAmountCents   Int?
  detail                String                 @db.VarChar(1000)
  createdAt             DateTime               @default(now())
  resolvedAt            DateTime?
  resolvedById          String?
  resolvedBy            User?                  @relation(fields: [resolvedById], references: [id], onDelete: Restrict)
  resolutionNote        String?                @db.VarChar(1000)

  @@unique([type, provider, providerTransactionId])
  @@index([status, createdAt])
  @@index([orderGroupId])
  @@map("payment_exceptions")
}

// ----------------------------------------------------------------------------
// Inventory ledger on the single stock counter (specs/commerce/25 slice S3,
// TD-08 approved 2026-10-31). Every change of ProductVariant.stockQuantity is
// one row here, in the same transaction as the change. Phase-0 subset of
// commerce/02 MovementType; the warehouse types come with Phase 1.
// ----------------------------------------------------------------------------

enum InventoryMovementType {
  OPENING_BALANCE // backfill of the counter as it was when the ledger started
  RESERVE // checkout took units (stock -= q)
  RELEASE // cancel / expiry gave them back (stock += q)
  VENDOR_ADJUSTMENT // the vendor's own delta with a reason (initial stock included)
}

// Append-only (trigger in the migration). quantityAfter = quantityBefore +
// quantityDelta and quantityAfter >= 0 are CHECKs, so the ledger and the
// counter can be reconciled: SUM(quantityDelta) per variant = stockQuantity.
model InventoryMovement {
  id             String                @id @default(uuid())
  variantId      String
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type           InventoryMovementType
  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int
  orderGroupId   String?
  orderGroup     OrderGroup?           @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  actorUserId    String?
  actor          User?                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  source         String                @db.VarChar(32) // checkout | shopper_cancel | admin_cancel | expiry | vendor | migration
  reason         String?               @db.VarChar(500)
  createdAt      DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([orderGroupId])
  @@map("inventory_movements")
}

// ----------------------------------------------------------------------------
// Request idempotency (specs/commerce/25 slice S4, TD-07 approved 2026-10-31):
// a client that retries POST /checkout with the same Idempotency-Key gets the
// same order group, never a second one. Subset of commerce/02 §3.3.
// ----------------------------------------------------------------------------

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model IdempotencyKey {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  scope          String            @db.VarChar(32) // checkout
  key            String            @db.VarChar(128)
  status         IdempotencyStatus @default(IN_PROGRESS)
  // A crashed request stops holding the key after this; its order group (if it
  // committed) is still found through orderGroupId.
  lockedUntil    DateTime
  // Set INSIDE the checkout transaction, so "the order exists" and "the key
  // points to it" commit together.
  orderGroupId   String?           @unique
  orderGroup     OrderGroup?       @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  expiresAt      DateTime

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

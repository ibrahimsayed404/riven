// ============================================================================
// Riven — Prisma Schema (v1)
// PostgreSQL + PostGIS
//
// Notes on PostGIS:
// - Prisma has no native geography type, so location columns use
//   `Unsupported("geography(Point, 4326)")`. Prisma Client will NOT let you
//   query/write these directly — do that via `$queryRaw` / `$executeRaw`
//   in the repository layer (e.g. bazaars.repository.ts), never in services.
// - GIST spatial indexes are NOT created by `prisma migrate dev` for
//   Unsupported columns. After each migration that touches a location
//   column, hand-add the index in that migration's generated SQL file:
//     CREATE INDEX bazaar_location_gist ON "Bazaar" USING GIST (location);
//   This file's inline comments mark every column that needs one.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  SHOPPER
  VENDOR
  ORGANIZER
  ADMIN
}

enum ScheduleType {
  ONE_OFF
  RECURRING
}

enum BazaarStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EventType {
  TALK
  MEETUP
  SCREENING
  MARKET
}

enum FollowableType {
  VENDOR
  BAZAAR
}

enum FavorableType {
  VENDOR
  BAZAAR
  EVENT
  PRODUCT
}

enum RatingTargetType {
  VENDOR
  BAZAAR
  EVENT
  PRODUCT
}

enum NotificationType {
  BAZAAR_NEARBY
  FOLLOWED_VENDOR_NEW_BAZAAR
  EVENT_REMINDER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PayerType {
  VENDOR
  ORGANIZER
}

enum PaymentPurpose {
  SUBSCRIPTION
  BAZAAR_FEE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum VendorType {
  BAZAAR_ONLY
  MARKETPLACE
  BOTH
}

// What a vendor sells, for discovery/search filters. Product taxonomy is the
// separate Category tree; this is the vendor-level label (fix.js SCHEMA-02).
enum VendorCategory {
  FASHION
  FOOD
  HOME_CRAFTS
  BEAUTY
  ACCESSORIES
  KIDS
  ART
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
}

// One value per auditable admin action. A new admin write is audited only if
// a value is added here AND the service calls AuditService.record().
enum AdminAction {
  VENDOR_VERIFIED
  VENDOR_REJECTED
  ORGANIZER_VERIFIED
  ORGANIZER_REJECTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  USER_DEACTIVATED
  USER_REACTIVATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  // Admin Part B (specs/admin-module-spec3.md)
  VENDOR_EDITED
  PRODUCT_EDITED
  PRODUCT_DELETED
  CATEGORY_DELETED
  RATING_DELETED
  RATING_COMMENT_CLEARED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  ORDER_CANCELLED
  BAZAAR_CANCELLED
  BOOTH_LAYOUT_CREATED
  BOOTH_LAYOUT_UPDATED
  BOOTH_CREATED
  BOOTH_UPDATED
  BOOTH_DELETED
  BOOTH_ASSIGNED
  BOOTH_UNASSIGNED
  SEARCH_REINDEX_REQUESTED
}

enum AdminTargetType {
  VENDOR
  ORGANIZER
  PRODUCT
  USER
  CATEGORY
  // Admin Part B (specs/admin-module-spec3.md)
  RATING
  APPLICATION
  ORDER
  BAZAAR
  BOOTH
  SEARCH_INDEX
}

// ----------------------------------------------------------------------------
// Identity
// ----------------------------------------------------------------------------

model User {
  id           String                                 @id @default(uuid())
  name         String
  email        String                                 @unique
  phone        String?                                @unique
  passwordHash String
  role         Role
  // Admin suspension (PATCH /admin/users/:id/deactivate). Distinct from deletedAt,
  // which is the owner's own DELETE /users/me — a suspended user gets a clear
  // ACCOUNT_DEACTIVATED at login, a deleted one looks like it never existed.
  isActive     Boolean                                @default(true)
  // GIST index required: CREATE INDEX user_location_gist ON "User" USING GIST (location);
  location     Unsupported("geography(Point, 4326)")?
  interests    String[]                               @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vendor        Vendor?
  organizer     Organizer?
  follows       Follow[]
  favorites     Favorite[]
  ratings       Rating[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  auditLogs     AdminAuditLog[]
  cart          Cart?
  orderGroups   OrderGroup[]
  orders        Order[]

  @@index([role])
  @@map("users")
}

// A row per issued refresh token, not just one column on User — this lets a
// user be logged in on multiple devices (phone + web) and lets you revoke
// one session without killing every session. Token itself is never stored
// raw: only its hash, so a leaked DB dump doesn't hand out live sessions.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model Vendor {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name               String
  category           VendorCategory                         @default(OTHER)
  description        String?
  logo               String?
  coverMedia         String[]                               @default([])
  hasFixedLocation   Boolean                                @default(false)
  // GIST index required: CREATE INDEX vendor_home_location_gist ON "Vendor" USING GIST ("homeLocation");
  homeLocation       Unsupported("geography(Point, 4326)")?
  verified           Boolean                                @default(false)
  // Current rejection state only — null when pending or verified. History lives in AdminAuditLog.
  rejectionReason    String?
  subscriptionStatus SubscriptionStatus                     @default(TRIALING)

  vendorType     VendorType @default(BAZAAR_ONLY)
  brandStory     String?
  logoUrl        String?
  bannerUrl      String?
  returnPolicy   String?
  shippingPolicy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products      Product[]
  orders        Order[]
  boothListings BoothListing[]
  subscription  Subscription?

  @@index([category])
  @@index([verified])
  @@map("vendors")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  @@map("categories")
}

model Product {
  id       String @id @default(uuid())
  vendorId String
  // Restrict: a vendor with products is soft-deleted, never removed.
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  title       String
  description String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  basePrice   Decimal  @db.Decimal(12, 2)
  images      String[]

  isActive Boolean @default(true)

  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([vendorId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  sku           String   @unique
  size          String?
  color         String?
  priceOverride Decimal? @db.Decimal(12, 2) // null = use Product.basePrice
  stockQuantity Int      @default(0)
  // Soft-delete: order_items / cart_items reference variants with RESTRICT, so a
  // hard delete 500s the moment anyone has bought or carted it.
  deletedAt     DateTime?

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Organizer {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name     String
  verified        Boolean @default(false)
  // Current rejection state only — null when pending or verified. History lives in AdminAuditLog.
  rejectionReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bazaars Bazaar[]
  events  Event[]

  @@map("organizers")
}

// ----------------------------------------------------------------------------
// Bazaars, booths, events
// ----------------------------------------------------------------------------

model Bazaar {
  id          String    @id @default(uuid())
  organizerId String
  // Restrict: don't allow deleting an organizer with active bazaars —
  // force explicit handling (cancel/transfer bazaars first).
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  name           String
  description    String?
  coverMedia     String[]                              @default([])
  // GIST index required: CREATE INDEX bazaar_location_gist ON "Bazaar" USING GIST (location);
  location       Unsupported("geography(Point, 4326)")
  scheduleType   ScheduleType
  recurrenceRule String? // e.g. iCal RRULE string, required if scheduleType = RECURRING
  startDate      DateTime
  // CHECK bazaars_end_date_not_before_start (migration SQL only, Prisma can't model it):
  // endDate IS NULL OR endDate >= startDate.
  endDate        DateTime?
  status         BazaarStatus                          @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  boothListings BoothListing[]
  boothLayout   BoothLayout?
  events        Event[]

  @@index([status])
  @@index([organizerId])
  @@map("bazaars")
}

model BoothLayout {
  id         String @id @default(uuid())
  bazaarId   String @unique
  bazaar     Bazaar @relation(fields: [bazaarId], references: [id], onDelete: Cascade)
  gridConfig Json // { rows, cols, cellSize, background? } — isometric render config

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booths Booth[]

  @@map("booth_layouts")
}

model Booth {
  id        String      @id @default(uuid())
  layoutId  String
  layout    BoothLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  label     String // e.g. "A-12"
  positionX Int
  positionY Int
  width     Int
  height    Int

  boothListingId String?       @unique
  boothListing   BoothListing? @relation(fields: [boothListingId], references: [id], onDelete: SetNull)

  @@unique([layoutId, label])
  @@index([layoutId])
  @@map("booths")
}

model BoothListing {
  id                String            @id @default(uuid())
  bazaarId          String
  bazaar            Bazaar            @relation(fields: [bazaarId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  applicationStatus ApplicationStatus @default(PENDING)
  appliedAt         DateTime          @default(now())
  decidedAt         DateTime?

  booth Booth?

  // A vendor can't apply to the same bazaar twice — DB-enforced, not app-level,
  // so concurrent requests can't race past an application-status check.
  @@unique([bazaarId, vendorId])
  @@index([bazaarId, applicationStatus])
  @@index([vendorId])
  @@map("booth_listings")
}

model Event {
  id          String    @id @default(uuid())
  bazaarId    String?
  bazaar      Bazaar?   @relation(fields: [bazaarId], references: [id], onDelete: Cascade)
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  title      String
  type       EventType
  // GIST index required: CREATE INDEX event_location_gist ON "Event" USING GIST (location);
  location   Unsupported("geography(Point, 4326)")
  startsAt   DateTime
  endsAt     DateTime?
  coverMedia String[]                              @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizerId])
  @@index([bazaarId])
  @@index([startsAt])
  @@map("events")
}

// ----------------------------------------------------------------------------
// Social: follow / favorite / rating
// Polymorphic target (followableType/Id etc.) — integrity enforced in the
// service layer, not a DB foreign key, by design (per architecture doc).
// ----------------------------------------------------------------------------

model Follow {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Polymorphic target — intentionally NOT a DB foreign key (followableId can
  // point at Vendor or Bazaar). Integrity is enforced in follows.service.ts:
  // verify the target exists before insert. See backend-architecture.md §1.
  followableType FollowableType
  followableId   String

  createdAt DateTime @default(now())

  @@unique([userId, followableType, followableId])
  @@index([followableType, followableId])
  @@map("follows")
}

model Favorite {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorableType FavorableType
  favorableId   String

  createdAt DateTime @default(now())

  @@unique([userId, favorableType, favorableId])
  @@index([favorableType, favorableId])
  @@map("favorites")
}

model Rating {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType RatingTargetType
  targetId   String
  score      Int // 1-5, enforce range via CHECK constraint below
  comment    String?
  // Required for VENDOR/PRODUCT (verified delivered purchase); null for BAZAAR,
  // which any shopper may rate once it is PUBLISHED or COMPLETED (fix.js SPEC-03).
  orderId    String?
  // Restrict: order history that a rating points at is never hard-deleted.
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, targetType, targetId]) // one rating per user per target
  @@index([targetType, targetId])
  @@index([orderId])
  @@map("ratings")
}

// ----------------------------------------------------------------------------
// Notifications
// ----------------------------------------------------------------------------

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  idempotencyKey String?          @unique
  payload        Json
  readAt         DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// Admin audit log
// ----------------------------------------------------------------------------

// Append-only record of moderation actions. Written best-effort after the
// domain write commits (see specs/admin-module-spec.md §5). No FK on targetId:
// it points at four different tables; the acting service checks existence.
model AdminAuditLog {
  id         String          @id @default(uuid())
  actorId    String
  // Restrict: an audit row must outlive its actor. Users are soft-deleted in
  // production, so this only bites hard-deletes in e2e cleanup.
  actor      User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     AdminAction
  targetType AdminTargetType
  targetId   String
  reason     String?
  createdAt  DateTime        @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ----------------------------------------------------------------------------
// Payments
// ----------------------------------------------------------------------------

model Subscription {
  id               String             @id @default(uuid())
  vendorId         String             @unique
  vendor           Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan             String
  status           SubscriptionStatus @default(TRIALING)
  paymobRef        String?
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Payment {
  id        String         @id @default(uuid())
  payerType PayerType
  payerId   String
  amount    Decimal        @db.Decimal(10, 2)
  purpose   PaymentPurpose
  paymobRef String?        @unique
  status    PaymentStatus  @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payerType, payerId])
  @@index([status])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// Marketplace (Cart & Orders)
// ----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Restrict)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// Groups sub-orders created from a single checkout action (multi-vendor cart)
model OrderGroup {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders         Order[]
  paymobIntentId String?
  // Set by the webhook. Unique so a replayed or duplicated webhook is a P2002,
  // not a second PAID transition. paidAmountCents is what Paymob said it took.
  // Paymob's own order id, returned when the intention is created; it is one
  // of the fields Paymob signs in the webhook, so it is what we match on.
  paymobOrderId       String?
  paymobTransactionId String?   @unique
  paidAmountCents     Int?
  paidAt              DateTime?
  createdAt      DateTime @default(now())

  @@index([paymobIntentId])
  @@index([paymobOrderId])
  @@map("order_groups")
}

// One Order per vendor per checkout
model Order {
  id           String     @id @default(uuid())
  orderGroupId String
  orderGroup   OrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  vendorId     String
  vendor       Vendor     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  status   OrderStatus @default(PENDING)
  subtotal Decimal     @db.Decimal(12, 2)
  items    OrderItem[]
  ratings  Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([vendorId, status])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Snapshot at purchase time — never read from Product/Variant after order creation
  titleSnapshot String
  priceSnapshot Decimal @db.Decimal(12, 2)
  quantity      Int

  @@map("order_items")
}

// ----------------------------------------------------------------------------
// Post-migration raw SQL to hand-add (not generated by Prisma):
//
//   CREATE INDEX user_location_gist       ON "users"   USING GIST (location);
//   CREATE INDEX vendor_home_location_gist ON "vendors" USING GIST ("homeLocation");
//   CREATE INDEX bazaar_location_gist     ON "bazaars" USING GIST (location);
//   CREATE INDEX event_location_gist      ON "events"  USING GIST (location);
//
//   ALTER TABLE "ratings" ADD CONSTRAINT rating_score_range
//     CHECK (score >= 1 AND score <= 5);
// ----------------------------------------------------------------------------

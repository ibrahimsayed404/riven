# Riven — root environment template
# Copy to .env and fill in values. Never commit .env files.
#
# Validated at app boot per specs/riven-backend-architecture.md §5.
# Local Docker stack: docker-compose.yml (Postgres on host port 5433).

# --- Database ---
# Postgres runs on host port 5433 (not 5432) to avoid conflicting with a system Postgres install.
DATABASE_URL="postgresql://riven:riven_dev_password@localhost:5433/riven?schema=public"

# --- Redis / Queue (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Search (Meilisearch) ---
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="riven_dev_master_key"
# Optional. Index uid prefix; defaults to "riven_<NODE_ENV>_" (e.g. riven_development_products).
# MEILISEARCH_INDEX_PREFIX="riven_development_"

# --- Auth (JWT) ---
JWT_SECRET="replace_with_32+_char_random_string_min"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

# --- Payments (Paymob) ---
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_HMAC_SECRET=""
# Required whenever PAYMOB_HMAC_SECRET is set: the merchant id Paymob signs as `owner` (dashboard → profile).
PAYMOB_MERCHANT_ID=""

# --- Media storage (S3-compatible) ---
# Local dev values match the minio service in docker-compose.yml.
# For Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
# S3_REGION=auto, S3_PUBLIC_URL=<your r2.dev or custom domain>/<bucket>.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="riven-media"
S3_ACCESS_KEY_ID="riven"
S3_SECRET_ACCESS_KEY="riven_dev_password"
# Base URL the browser reads uploaded objects from (no trailing slash).
S3_PUBLIC_URL="http://localhost:9000/riven-media"

# --- HTTP ---
# How many reverse proxies sit in front of the API, or which proxy addresses to
# trust. This decides where req.ip comes from, which is what rate limiting keys
# anonymous callers by.
#   false            no proxy — the process is reached directly (default)
#   1                exactly one trusted hop (nginx, an ALB, a PaaS router)
#   10.0.0.0/8,loopback   trust these addresses/CIDRs, or an Express preset
# Set this to match the real deployment. Too low and every anonymous caller
# shares one rate-limit bucket; "true" is rejected at boot because it trusts a
# client-supplied X-Forwarded-For and lets anyone forge their own identity.
# TRUST_PROXY="false"
# Comma-separated browser origins allowed by CORS. Defaults to the local dashboards.
# CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Minutes a PENDING checkout keeps its reserved stock before the expiry job cancels it.
# CHECKOUT_PENDING_TTL_MINUTES=60
# Which process runs the reservation-expiry worker and owns its schedule:
# "all" = this API (default), "api" = HTTP only (a separate worker runs it), "worker" = worker entry point.
# PROCESS_ROLE="all"
# Optional heartbeat URL pinged after each successful expiry run ("/fail" appended on failure).
# EXPIRY_HEARTBEAT_URL=""
# Shared secret (≥ 16 chars) for /health/dependencies and /health/maintenance (header x-health-token).
# Unset = those monitor endpoints are disabled; the plain /health stays public.
# HEALTH_CHECK_TOKEN=""

# --- App ---
PORT=3000
NODE_ENV="development"
